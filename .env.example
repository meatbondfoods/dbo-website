# MeatBond Mart - leave Supabase values empty to run the built-in demo catalogue.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data source: "demo" (default) or "erp" (Supabase-backed adapter once mapped)
MART_DATA_SOURCE=demo
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact + social details shown in the footer and Contact page.
# Leave blank until confirmed by the business: nothing is shown if unset.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Customer accounts (Supabase Auth: email + password, email verification required) ---
# Accounts are OFF on deployed sites. Setting the Supabase keys alone does NOT turn them on.
# To activate (only after the owner approves the Supabase configuration and migrations 101-106 are applied to the
# development project first): set MART_AUTH=supabase AND the two public values below.
#   Supabase Auth must have: Email provider on, "Confirm email" ON, redirect URL <NEXT_PUBLIC_SITE_URL>/auth/callback.
MART_AUTH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER put the Supabase service-role key in this project. It is not used.
# Local development only: leave MART_AUTH unset to use the file-backed demo accounts and the demo admin
# (credentials are generated into .data/dev-admin.json on first run). Demo mode is impossible in production.
