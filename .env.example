# MeatBond Mart - leave Supabase values empty to run the built-in demo catalogue.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data source: "demo" (default) or "erp" (Supabase-backed adapter once mapped)
MART_DATA_SOURCE=demo
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact + social details shown in the footer and Contact page.
# Leave blank until confirmed by the business: nothing is shown if unset.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
